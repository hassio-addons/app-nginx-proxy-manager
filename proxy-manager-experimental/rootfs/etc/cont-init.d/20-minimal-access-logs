#!/usr/bin/with-contenv bashio
set -euo pipefail

echo "[INFO] Enabling concise Nginx access logging with HA noise suppression..."

NGINX_CONF="/etc/nginx/nginx.conf"
SUPPRESS_MAP_CONF="/etc/nginx/conf.d/suppress-map.conf"

# -------------------------------------------------
# Check for nginx.conf
# -------------------------------------------------
if [[ ! -f "$NGINX_CONF" ]]; then
    echo "[ERROR] Main nginx.conf not found at $NGINX_CONF - aborting"
    exit 1
fi

echo "[INFO] Using main nginx config: $NGINX_CONF"

# -------------------------------------------------
# Create enhanced generalized suppression map
# -------------------------------------------------
if [[ ! -f "$SUPPRESS_MAP_CONF" ]]; then
    echo "[INFO] Creating enhanced suppression map: $SUPPRESS_MAP_CONF"
    cat > "$SUPPRESS_MAP_CONF" <<'EOF'
map $request_uri $loggable {
    default 1;
    
    # Common web application noise patterns
    ~*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)(\?.*)?$ 0;
    ~*/(favicon\.ico|robots\.txt) 0;
    ~*/(health|status|metrics|ping|ready|live) 0;
    ~*/api/ 0;
    ~*/websocket 0;
    ~*/socket\.io 0;
    ~*/static/ 0;
    ~*/assets/ 0;
    ~*/img/ 0;
    ~*/css/ 0;
    ~*/js/ 0;
    ~*/fonts/ 0;
    ~*/vendor/ 0;
    ~*/build/ 0;
    ~*/dist/ 0;
    ~*/public/ 0;
    ~*/_next/ 0;
    ~*/webpack/ 0;
    ~*/manifest 0;
    ~*/service-worker 0;
    ~*/sw\.js 0;
    
    # Rate-based suppression simulation
    ~*/refresh 0;
    ~*/poll 0;
    ~*/update 0;
    ~*/sync 0;
    ~*/notifications 0;
    ~*/events 0;
    ~*/stream 0;
    ~*/watch 0;
    ~*/live 0;
    
    # Plex-specific patterns (query parameter aware)
    ~*/web/.*\.(css|js|json) 0;
    ~*/identity(\?.*)?$ 0;
    ~*/media/providers(\?.*)?$ 0;
    ~*/:/prefs(\?.*)?$ 0;
    ~*X-Plex-Product= 0;
    ~*X-Plex-Client-Identifier= 0;
    ~*X-Plex-Token= 0;
}
EOF
else
    echo "[INFO] Suppression map already exists"
fi

# -------------------------------------------------
# Insert minimal log_format (if missing)
# -------------------------------------------------
if ! grep -q "log_format minimal" "$NGINX_CONF"; then
    echo "[INFO] Adding minimal log_format to nginx.conf ..."
    awk '
        $0 ~ /^[[:space:]]*http[[:space:]]*\{/ && !done {
            print;
            print "    log_format minimal \"$remote_addr -> $host $status \\\"$request\\\" $request_time s\";";
            done=1; next
        }
        { print }
    ' "$NGINX_CONF" > "${NGINX_CONF}.tmp" && mv "${NGINX_CONF}.tmp" "$NGINX_CONF"
    echo "[INFO] Minimal log format added successfully"
else
    echo "[INFO] Minimal log format already exists"
fi

# -------------------------------------------------
# Ensure suppression map is included in nginx.conf
# -------------------------------------------------
if ! grep -q "suppress-map.conf" "$NGINX_CONF"; then
    echo "[INFO] Linking suppression map inside nginx.conf ..."
    sed -i '/http {/a\    include /etc/nginx/conf.d/suppress-map.conf;' "$NGINX_CONF"
    echo "[INFO] Suppression map include added"
else
    echo "[INFO] Suppression map already linked"
fi

# -------------------------------------------------
# Patch proxy host configurations (preserve per-host logs)
# -------------------------------------------------
echo "[INFO] Patching proxy host configurations (preserve per-host log files)..."

for proxy_file in /config/nginx/proxy_host/*.conf; do
    [[ -f "$proxy_file" ]] || continue

    if grep -q "access_log.*minimal.*if=\$loggable" "$proxy_file" 2>/dev/null; then
        echo "[INFO] Already patched: $(basename "$proxy_file")"
        continue
    fi

    # Replace or add access_log directive
    if sed -r -i 's|([[:space:]]*)access_log[[:space:]]+([^[:space:];]+)[^;]*;|\1access_log \2 minimal if=\$loggable;|g' "$proxy_file"; then
        if grep -q "access_log .*minimal.*if=\$loggable" "$proxy_file"; then
            echo "[INFO] Patched $(basename "$proxy_file")"
        else
            echo "[WARN] No access_log directive found in $(basename "$proxy_file"); adding new one"
            awk '/^[[:space:]]*server[[:space:]]*{/ && !added {
                    print;
                    print "    access_log /data/logs/proxy_host-'"$(basename "$proxy_file" .conf)"'.log minimal if=$loggable;";
                    added=1; next
                 } {print}' "$proxy_file" > "${proxy_file}.tmp" &&
            install -m 644 "${proxy_file}.tmp" "$proxy_file" && rm -f "${proxy_file}.tmp"
            echo "[INFO] Added access_log to $(basename "$proxy_file")"
        fi
    else
        echo "[ERROR] Failed to patch $(basename "$proxy_file")" >&2
        continue
    fi
done

# -------------------------------------------------
# Ensure log directories exist
# -------------------------------------------------
for dir in /var/log/nginx /var/lib/nginx/logs; do
    if [[ ! -d "$dir" ]]; then
        echo "[INFO] Creating log directory: $dir"
        mkdir -p "$dir" 2>/dev/null || echo "[WARN] Failed to create directory $dir"
    fi
done

# -------------------------------------------------
# Validate Nginx configuration
# -------------------------------------------------
echo "[INFO] Validating Nginx configuration..."
if grep -q "%%dns_host%%" /etc/nginx/conf.d/include/resolvers.conf 2>/dev/null; then
    echo "[INFO] Skipping nginx test - template placeholders present (normal for NPM)"
else
    if nginx -t 2>&1 | grep -q "syntax is ok"; then
        echo "[INFO] Nginx configuration syntax OK"
    else
        echo "[ERROR] Nginx configuration test failed"
        nginx -t || true
    fi
fi

# -------------------------------------------------
# Summary
# -------------------------------------------------
echo "[INFO] Enhanced access logging configuration complete"
echo "[INFO] The following Home Assistant API calls should now be suppressed:"
echo "[INFO]   - /auth/token, /manifest.json, /service_worker.js"
echo "[INFO]   - /api/websocket, /api/calendars/, /api/webhook/"
echo "[INFO]   - /static/, /frontend_latest/, /local/, /media/"
echo "[INFO] NPM per-host logging functionality preserved"
