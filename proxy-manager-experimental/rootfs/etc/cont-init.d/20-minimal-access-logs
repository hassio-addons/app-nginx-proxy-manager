#!/usr/bin/with-contenv bashio
set -euo pipefail

echo "[INFO] Enabling concise Nginx access logging with HA noise suppression..."
echo "[DEBUG] Starting minimal access logs configuration"

# -------------------------------------------------
# Locate the template that contains the http{} block
# -------------------------------------------------
echo "[INFO] Searching for Nginx templates..."

# Try multiple possible locations
POSSIBLE_PATHS=(
    "/opt/nginx-proxy-manager/templates"
    "/etc/nginx/templates" 
    "/templates"
    "/app/templates"
    "/usr/local/nginx/templates"
)

NGINX_TPL=""
for path in "${POSSIBLE_PATHS[@]}"; do
    if [[ -d "$path" ]]; then
        echo "[DEBUG] Checking path: $path"
        # Use find instead of grep to avoid permission issues
        if find "$path" -name "*.conf" -type f 2>/dev/null | head -n1 | grep -q .; then
            NGINX_TPL=$(find "$path" -name "*.conf" -type f 2>/dev/null | head -n1)
            # Now check if this file contains http block
            if [[ -n "$NGINX_TPL" ]] && grep -q 'http[[:space:]]*{' "$NGINX_TPL" 2>/dev/null; then
                echo "[INFO] Found template: $NGINX_TPL"
                break
            fi
        fi
        NGINX_TPL=""
    fi
done

# If still not found, try to find nginx.conf in common locations
if [[ -z "$NGINX_TPL" ]]; then
    echo "[DEBUG] No templates found in standard directories, searching for nginx.conf"
    POSSIBLE_NGINX_CONF=(
        "/etc/nginx/nginx.conf"
        "/opt/nginx-proxy-manager/nginx.conf"
        "/usr/local/nginx/conf/nginx.conf"
    )
    for conf in "${POSSIBLE_NGINX_CONF[@]}"; do
        if [[ -f "$conf" ]] && grep -q 'http[[:space:]]*{' "$conf" 2>/dev/null; then
            NGINX_TPL="$conf"
            echo "[INFO] Using nginx.conf: $NGINX_TPL"
            break
        fi
    done
fi

if [[ -z "$NGINX_TPL" ]]; then
    echo "[WARN] No template with http{} block found - will proceed with direct nginx.conf modification only"
    TEMPLATES_DIR=""
else
    TEMPLATES_DIR="$(dirname "$NGINX_TPL")"
    echo "[INFO] Template directory: $TEMPLATES_DIR"
fi

NGINX_CONF="/etc/nginx/nginx.conf"

# Verify nginx.conf exists
if [[ ! -f "$NGINX_CONF" ]]; then
    echo "[ERROR] Main nginx.conf not found at $NGINX_CONF - aborting"
    exit 1
fi

echo "[INFO] Using main nginx config: $NGINX_CONF"

# -------------------------------------------------
# Insert minimal log format (if missing)
# -------------------------------------------------
if ! grep -q "log_format minimal" "$NGINX_CONF"; then
    echo "[INFO] Adding minimal log_format to $NGINX_CONF ..."
    if awk '
        $0 ~ /^[[:space:]]*http[[:space:]]*\{/ && !done {
            print;
            print "    log_format minimal \"$remote_addr $host $status \\\"$request\\\" $request_time s\";";
            done=1; next
        }
        { print }
    ' "$NGINX_CONF" > "${NGINX_CONF}.tmp" 2>/dev/null; then
        mv "${NGINX_CONF}.tmp" "$NGINX_CONF"
        echo "[INFO] Minimal log format added successfully"
    else
        echo "[ERROR] Failed to add minimal log format"
        rm -f "${NGINX_CONF}.tmp" 2>/dev/null || true
    fi
else
    echo "[INFO] Minimal log format already exists"
fi

# -------------------------------------------------
# Insert request‑URI suppression map (if missing)
# -------------------------------------------------
if ! grep -q 'map \$request_uri \$loggable' "$NGINX_CONF"; then
    echo "[INFO] Adding request‑URI suppression map to $NGINX_CONF ..."
    if awk '
        $0 ~ /^[[:space:]]*http[[:space:]]*\{/ && !map_done {
            print;
            print "    map $request_uri $loggable {";
            print "        default 1;";
            print "        ~^/api/ping 0;";
            print "        ~^/api/websocket 0;";
            print "        ~^/api/hassio_ingress/ 0;";
            print "        ~^/hassio_ingress/ 0;";
            print "        ~^/hassio_ingress/.*/api/calendars/ 0;";
            print "        ~^/api/events 0;";
            print "        ~^/api/history 0;";
            print "        ~^/api/logbook 0;";
            print "        ~^/api/states 0;";
            print "        ~^/api/template 0;";
            print "        ~^/api/config 0;";
            print "        ~^/api/calendars/ 0;";
            print "        ~^/auth/token 0;";
            print "        ~^/auth/providers 0;";
            print "        ~^/manifest\\.json 0;";
            print "        ~^/service_worker\\.js 0;";
            print "        ~^/static/ 0;";
            print "        ~^/frontend_latest/ 0;";
            print "        ~^/local/ 0;";
            print "        ~^/media/ 0;";
            print "    }";
            map_done=1; next
        }
        { print }
    ' "$NGINX_CONF" > "${NGINX_CONF}.tmp" 2>/dev/null; then
        mv "${NGINX_CONF}.tmp" "$NGINX_CONF"
        echo "[INFO] Request URI suppression map added successfully"
    else
        echo "[ERROR] Failed to add request URI suppression map"
        rm -f "${NGINX_CONF}.tmp" 2>/dev/null || true
    fi
else
    echo "[INFO] Request URI suppression map already exists"
fi

# -------------------------------------------------
# Patch each generated server template (if templates directory exists)
# -------------------------------------------------
if [[ -n "$TEMPLATES_DIR" && -d "$TEMPLATES_DIR" ]]; then
    echo "[INFO] Patching templates in $TEMPLATES_DIR"
    for tpl in "$TEMPLATES_DIR"/*.conf; do
        [[ -f "$tpl" ]] || continue
        echo "[DEBUG] Processing template: $(basename "$tpl")"
        
        if grep -q "access_log" "$tpl" 2>/dev/null; then
            # Replace any existing access_log line
            if sed -i -E 's|access_log\s+[^;]+;|access_log /var/log/nginx/access.log minimal if=$loggable;|g' "$tpl" 2>/dev/null; then
                echo "[INFO] Replaced access_log in $(basename "$tpl")"
            else
                echo "[WARN] Failed to replace access_log in $(basename "$tpl")"
            fi
        else
            # Append a minimal access_log right after the first server{ line
            if awk '/^[[:space:]]*server[[:space:]]*{/ && !added {print; print "    access_log /var/log/nginx/access.log minimal if=$loggable;"; added=1; next} {print}' "$tpl" > "${tpl}.tmp" 2>/dev/null; then
                if mv "${tpl}.tmp" "$tpl" 2>/dev/null; then
                    echo "[INFO] Added access_log to $(basename "$tpl")"
                else
                    echo "[WARN] Failed to update $(basename "$tpl")"
                    rm -f "${tpl}.tmp" 2>/dev/null || true
                fi
            else
                echo "[WARN] Failed to process $(basename "$tpl")"
                rm -f "${tpl}.tmp" 2>/dev/null || true
            fi
        fi
    done
else
    echo "[WARN] Template directory not found or empty – skipping template patching"
    echo "[INFO] Will rely on main nginx.conf configuration only"
fi

# -------------------------------------------------
# Ensure log directory exists
# -------------------------------------------------
LOG_DIR="/var/log/nginx"
if [[ ! -d "$LOG_DIR" ]]; then
    echo "[INFO] Creating log directory: $LOG_DIR"
    mkdir -p "$LOG_DIR" 2>/dev/null || echo "[WARN] Failed to create log directory"
fi

# -------------------------------------------------
# Validate the final Nginx configuration
# -------------------------------------------------
echo "[INFO] Validating Nginx configuration..."
if nginx -t 2>/dev/null; then
    echo "[INFO] Nginx configuration syntax OK"
else
    echo "[ERROR] Nginx configuration test failed"
    echo "[DEBUG] Showing nginx -t output:"
    nginx -t 2>&1 || true
    echo "[WARN] Continuing despite configuration test failure"
fi

echo "[INFO] Minimal access logging configuration complete"
echo "[INFO] The following paths will not be logged:"
echo "[INFO]   - /api/ping, /api/websocket, /api/hassio_ingress/"
echo "[INFO]   - /api/events, /api/history, /api/logbook, /api/states"
echo "[INFO]   - /api/template, /api/config, /api/calendars/"
echo "[INFO]   - /auth/token, /auth/providers"
echo "[INFO]   - /manifest.json, /service_worker.js"
echo "[INFO]   - /static/, /frontend_latest/, /local/, /media/"
