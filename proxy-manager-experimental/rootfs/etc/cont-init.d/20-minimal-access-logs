#!/usr/bin/with-contenv bash
set -e

echo "[INFO] Enabling concise Nginx access logging with HA noise suppression..."

NGINX_CONF="/opt/nginx-proxy-manager/templates/nginx.conf"
LOG_FORMAT="log_format minimal '\$remote_addr - \$remote_user [\$time_local] \"\$request\" \$status \$body_bytes_sent \"\$http_referer\" \"\$http_user_agent\"';"
ACCESS_LOG="access_log /data/logs/nginx/access.log minimal;"

# Check if http block exists
if ! grep -q '^[ \t]*http[ \t]*{' "$NGINX_CONF"; then
    echo "[ERROR] Could not find http{} block in $NGINX_CONF"
    exit 1
fi

# Check if minimal log_format is already present
if grep -q "log_format minimal" "$NGINX_CONF"; then
    echo "[INFO] Minimal log format already present. Skipping insertion."
    exit 0
fi

# Insert log_format and access_log after http { line
awk -v logfmt="$LOG_FORMAT" -v acc="$ACCESS_LOG" '
  /^[ \t]*http[ \t]*{/ {
    print
    print "    " logfmt
    print "    " acc
    next
  }
  { print }
' "$NGINX_CONF" > "${NGINX_CONF}.tmp" && mv "${NGINX_CONF}.tmp" "$NGINX_CONF"

# Verify insertion
if ! grep -q "log_format minimal" "$NGINX_CONF"; then
    echo "[ERROR] log_format minimal not found after insertion"
    exit 1
fi

echo "[INFO] Minimal log format successfully inserted."
