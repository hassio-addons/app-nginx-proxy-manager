#!/usr/bin/with-contenv bashio
set -euo pipefail

echo "[INFO] Enabling concise Nginx access logging with HA noise suppression..."

NGINX_CONF="/etc/nginx/nginx.conf"

# Verify nginx.conf exists
if [[ ! -f "$NGINX_CONF" ]]; then
    echo "[ERROR] Main nginx.conf not found at $NGINX_CONF - aborting"
    exit 1
fi

echo "[INFO] Using main nginx config: $NGINX_CONF"

# -------------------------------------------------
# Insert minimal log format (if missing)
# -------------------------------------------------
if ! grep -q "log_format minimal" "$NGINX_CONF"; then
    echo "[INFO] Adding minimal log_format to $NGINX_CONF ..."
    if awk '
        $0 ~ /^[[:space:]]*http[[:space:]]*\{/ && !done {
            print;
            print "    log_format minimal \"$remote_addr -> $host $status \\\"$request\\\" $request_time s\";";
            done=1; next
        }
        { print }
    ' "$NGINX_CONF" > "${NGINX_CONF}.tmp" 2>/dev/null; then
        mv "${NGINX_CONF}.tmp" "$NGINX_CONF"
        echo "[INFO] Minimal log format added successfully"
    else
        echo "[ERROR] Failed to add minimal log format"
        rm -f "${NGINX_CONF}.tmp" 2>/dev/null || true
        exit 1
    fi
else
    echo "[INFO] Minimal log format already exists"
fi

# -------------------------------------------------
# Insert request‑URI suppression map (if missing)
# -------------------------------------------------
if ! grep -q 'map \$request_uri \$loggable' "$NGINX_CONF"; then
    echo "[INFO] Adding request‑URI suppression map to $NGINX_CONF ..."
    if awk '
        $0 ~ /^[[:space:]]*http[[:space:]]*\{/ && !map_done {
            print;
            print "    map $request_uri $loggable {";
            print "        default 1;";
            print "        ~^/api/ping 0;";
            print "        ~^/api/websocket 0;";
            print "        ~^/api/hassio_ingress/ 0;";
            print "        ~^/hassio_ingress/ 0;";
            print "        ~^/hassio_ingress/.*/api/calendars/ 0;";
            print "        ~^/api/events 0;";
            print "        ~^/api/history 0;";
            print "        ~^/api/logbook 0;";
            print "        ~^/api/states 0;";
            print "        ~^/api/template 0;";
            print "        ~^/api/config 0;";
            print "        ~^/api/calendars/ 0;";
            print "        ~^/auth/token 0;";
            print "        ~^/auth/providers 0;";
            print "        ~^/manifest\\.json 0;";
            print "        ~^/service_worker\\.js 0;";
            print "        ~^/static/ 0;";
            print "        ~^/frontend_latest/ 0;";
            print "        ~^/local/ 0;";
            print "        ~^/media/ 0;";
            print "        ~^/api/webhook/ 0;";
            print "    }";
            map_done=1; next
        }
        { print }
    ' "$NGINX_CONF" > "${NGINX_CONF}.tmp" 2>/dev/null; then
        mv "${NGINX_CONF}.tmp" "$NGINX_CONF"
        echo "[INFO] Request URI suppression map added successfully"
    else
        echo "[ERROR] Failed to add request URI suppression map"
        rm -f "${NGINX_CONF}.tmp" 2>/dev/null || true
        exit 1
    fi
else
    echo "[INFO] Request URI suppression map already exists"
fi

# -------------------------------------------------
# Patch ALL nginx config files - SIMPLE approach
# -------------------------------------------------
echo "[INFO] Patching nginx configuration files..."

# Direct approach - patch any file with server blocks
find /etc/nginx /config/nginx /opt/nginx-proxy-manager -name "*.conf" -type f 2>/dev/null | while read -r config_file; do
    if [[ -f "$config_file" ]] && grep -q '^[[:space:]]*server[[:space:]]*{' "$config_file" 2>/dev/null; then
        echo "[INFO] Found server block in: $config_file"
        
        # Skip if already patched
        if grep -q "access_log.*minimal.*if=\$loggable" "$config_file" 2>/dev/null; then
            echo "[INFO] Already patched: $(basename "$config_file")"
            continue
        fi
        
        # Backup original file
        cp "$config_file" "${config_file}.bak" 2>/dev/null
        
        # Simple sed approach - replace any access_log line
        if sed -i 's|^[[:space:]]*access_log[[:space:]]\+[^;]\+;|    access_log /var/log/nginx/access.log minimal if=$loggable;|g' "$config_file" 2>/dev/null; then
            echo "[INFO] Replaced access_log in $(basename "$config_file")"
        else
            # If no access_log found, add one after server block
            if awk '/^[[:space:]]*server[[:space:]]*{/ && !added {print; print "    access_log /var/log/nginx/access.log minimal if=$loggable;"; added=1; next} {print}' "$config_file" > "${config_file}.tmp" 2>/dev/null; then
                if mv "${config_file}.tmp" "$config_file" 2>/dev/null; then
                    echo "[INFO] Added access_log to $(basename "$config_file")"
                else
                    echo "[WARN] Failed to update $(basename "$config_file") - restoring backup"
                    mv "${config_file}.bak" "$config_file" 2>/dev/null
                    rm -f "${config_file}.tmp" 2>/dev/null || true
                fi
            else
                echo "[WARN] Failed to process $(basename "$config_file") - restoring backup"
                mv "${config_file}.bak" "$config_file" 2>/dev/null
                rm -f "${config_file}.tmp" 2>/dev/null || true
            fi
        fi
        
        # Clean up backup
        rm -f "${config_file}.bak" 2>/dev/null || true
    fi
done

# -------------------------------------------------
# Force patch the main proxy host configs
# -------------------------------------------------
echo "[INFO] Force patching proxy host configurations..."
for proxy_file in /config/nginx/proxy_host/*.conf; do
    if [[ -f "$proxy_file" ]]; then
        echo "[INFO] Force patching: $(basename "$proxy_file")"
        
        # Create a clean patch
        if awk '
            /^[[:space:]]*server[[:space:]]*{/ && !added {
                print;
                print "    access_log /var/log/nginx/access.log minimal if=$loggable;";
                added=1; next
            }
            /^[[:space:]]*access_log/ { next }  # Remove any existing access_log lines
            { print }
        ' "$proxy_file" > "${proxy_file}.tmp" 2>/dev/null; then
            if mv "${proxy_file}.tmp" "$proxy_file" 2>/dev/null; then
                echo "[INFO] Successfully patched $(basename "$proxy_file")"
            else
                echo "[ERROR] Failed to replace $(basename "$proxy_file")"
                rm -f "${proxy_file}.tmp" 2>/dev/null || true
            fi
        else
            echo "[ERROR] Failed to create patch for $(basename "$proxy_file")"
            rm -f "${proxy_file}.tmp" 2>/dev/null || true
        fi
    fi
done

# -------------------------------------------------
# Ensure log directory exists
# -------------------------------------------------
LOG_DIR="/var/log/nginx"
if [[ ! -d "$LOG_DIR" ]]; then
    echo "[INFO] Creating log directory: $LOG_DIR"
    mkdir -p "$LOG_DIR" 2>/dev/null || echo "[WARN] Failed to create log directory"
fi

# Also create the directory that nginx expects for error logs
ERROR_LOG_DIR="/var/lib/nginx/logs"
if [[ ! -d "$ERROR_LOG_DIR" ]]; then
    echo "[INFO] Creating error log directory: $ERROR_LOG_DIR"
    mkdir -p "$ERROR_LOG_DIR" 2>/dev/null || echo "[WARN] Failed to create error log directory"
fi

# -------------------------------------------------
# Validate the final Nginx configuration
# -------------------------------------------------
echo "[INFO] Validating Nginx configuration..."
# Skip nginx test if template placeholders are present (normal for NPM)
if grep -q "%%dns_host%%" /etc/nginx/conf.d/include/resolvers.conf 2>/dev/null; then
    echo "[INFO] Skipping nginx test - template placeholders present (normal for NPM)"
else
    if output=$(nginx -t 2>&1); then
        echo "[INFO] Nginx configuration syntax OK"
    else
        echo "[ERROR] Nginx configuration test failed"
        echo "$output" >&2
        exit 1
    fi
fi

echo "[INFO] Enhanced access logging configuration complete"
echo "[INFO] Home Assistant API calls should now be suppressed"
