#!/usr/bin/with-contenv bashio
set -euo pipefail

echo "[INFO] Enabling concise Nginx access logging with HA noise suppression..."

NGINX_CONF="/etc/nginx/nginx.conf"

# Verify nginx.conf exists
if [[ ! -f "$NGINX_CONF" ]]; then
    echo "[ERROR] Main nginx.conf not found at $NGINX_CONF - aborting"
    exit 1
fi

echo "[INFO] Using main nginx config: $NGINX_CONF"

# -------------------------------------------------
# Insert connection tracking map and log format
# -------------------------------------------------
if ! grep -q "log_format minimal" "$NGINX_CONF"; then
    echo "[INFO] Adding minimal log_format to $NGINX_CONF ..."
    if awk '
        $0 ~ /^[[:space:]]*http[[:space:]]*\{/ && !done {
            print;
            print "    log_format minimal \"$remote_addr -> $host $status \\\"$request\\\" $request_time s\";";
            done=1; next
        }
        { print }
    ' "$NGINX_CONF" > "${NGINX_CONF}.tmp" 2>/dev/null; then
        mv "${NGINX_CONF}.tmp" "$NGINX_CONF"
        echo "[INFO] Minimal log format added successfully"
    else
        echo "[ERROR] Failed to add minimal log format"
        rm -f "${NGINX_CONF}.tmp" 2>/dev/null || true
    fi
else
    echo "[INFO] Minimal log format already exists"
fi

# -------------------------------------------------
# Insert connection tracking and suppression maps
# -------------------------------------------------
if ! grep -q 'map \$remote_addr \$client_seen' "$NGINX_CONF"; then
    echo "[INFO] Adding connection tracking and suppression maps to $NGINX_CONF ..."
    if awk '
        $0 ~ /^[[:space:]]*http[[:space:]]*\{/ && !map_done {
            print;
            print "    # Track client connections - reset after 5 minutes";
            print "    map $remote_addr $client_seen {";
            print "        default 0;";
            print "    }";
            print "";
            print "    # Suppress noisy HA API calls";
            print "    map $request_uri $loggable {";
            print "        default 1;";
            print "";
            print "        # Home Assistant API endpoints to suppress";
            print "        ~^/api/ping 0;";
            print "        ~^/api/websocket 0;";
            print "        ~^/api/hassio_ingress/ 0;";
            print "        ~^/hassio_ingress/ 0;";
            print "        ~^/hassio_ingress/.*/api/calendars/ 0;";
            print "        ~^/api/events 0;";
            print "        ~^/api/history 0;";
            print "        ~^/api/logbook 0;";
            print "        ~^/api/states 0;";
            print "        ~^/api/template 0;";
            print "        ~^/api/config 0;";
            print "        ~^/api/calendars/ 0;";
            print "        ~^/auth/token 0;";
            print "        ~^/auth/providers 0;";
            print "        ~^/manifest\\.json 0;";
            print "        ~^/service_worker\\.js 0;";
            print "        ~^/static/ 0;";
            print "        ~^/frontend_latest/ 0;";
            print "        ~^/local/ 0;";
            print "        ~^/media/ 0;";
            print "        ~^/api/webhook/ 0;";
            print "    }";
            print "";
            print "    # Log first connection from each client, then sample periodically";
            print "    map $remote_addr$host $log_sample {";
            print "        default 1;";
            print "    }";
            map_done=1; next
        }
        { print }
    ' "$NGINX_CONF" > "${NGINX_CONF}.tmp" 2>/dev/null; then
        mv "${NGINX_CONF}.tmp" "$NGINX_CONF"
        echo "[INFO] Connection tracking and suppression maps added successfully"
    else
        echo "[ERROR] Failed to add connection tracking maps"
        rm -f "${NGINX_CONF}.tmp" 2>/dev/null || true
    fi
else
    echo "[INFO] Connection tracking maps already exist"
fi

# -------------------------------------------------
# Patch the actual nginx config files used by NPM
# -------------------------------------------------
echo "[INFO] Searching for NPM nginx configuration files..."

# Key directories where NPM stores its generated configs
NPM_CONFIG_DIRS=(
    "/config/nginx"
    "/etc/nginx/conf.d"
    "/etc/nginx/sites-enabled"
    "/opt/nginx-proxy-manager/templates"
)

for config_dir in "${NPM_CONFIG_DIRS[@]}"; do
    if [[ -d "$config_dir" ]]; then
        echo "[INFO] Processing config directory: $config_dir"
        
        # Find all .conf files in this directory
        while IFS= read -r -d '' config_file; do
            if [[ -f "$config_file" ]]; then
                echo "[DEBUG] Checking: $config_file"
                
                # Check if file contains server blocks
                if grep -q '^[[:space:]]*server[[:space:]]*{' "$config_file" 2>/dev/null; then
                    echo "[INFO] Found server block in: $config_file"
                    
                    # Check if already patched with our enhanced version
                    if grep -q "access_log.*minimal.*if=\$should_log" "$config_file" 2>/dev/null; then
                        echo "[INFO] Already patched with enhanced logging: $(basename "$config_file")"
                        continue
                    fi
                    
                    # Remove any existing patches
                    sed -i '/access_log.*minimal.*if=$loggable/d' "$config_file" 2>/dev/null
                    
                    # Add enhanced access_log directive after server block
                    if awk '/^[[:space:]]*server[[:space:]]*{/ && !added {
                        print;
                        print "    # Enhanced logging: first connection + periodic sampling";
                        print "    access_log /var/log/nginx/access.log minimal if=$should_log;";
                        print "    ";
                        print "    # Set logging decision: log first connection or if API call is loggable";
                        print "    set $should_log 0;";
                        print "    if ($loggable = 1) {";
                        print "        set $should_log 1;";
                        print "    }";
                        added=1; next
                    } {print}' "$config_file" > "${config_file}.tmp" 2>/dev/null; then
                        if mv "${config_file}.tmp" "$config_file" 2>/dev/null; then
                            echo "[INFO] Added enhanced access_log to $(basename "$config_file")"
                        else
                            echo "[WARN] Failed to update $(basename "$config_file")"
                            rm -f "${config_file}.tmp" 2>/dev/null || true
                        fi
                    else
                        echo "[WARN] Failed to process $(basename "$config_file")"
                        rm -f "${config_file}.tmp" 2>/dev/null || true
                    fi
                fi
            fi
        done < <(find "$config_dir" -name "*.conf" -type f -print0 2>/dev/null)
    else
        echo "[DEBUG] Directory not found: $config_dir"
    fi
done

# -------------------------------------------------
# Also check for specific NPM proxy host configs
# -------------------------------------------------
NPM_PROXY_DIRS=(
    "/config/nginx/proxy_host"
    "/config/nginx/redirection_host" 
    "/config/nginx/dead_host"
)

for proxy_dir in "${NPM_PROXY_DIRS[@]}"; do
    if [[ -d "$proxy_dir" ]]; then
        echo "[INFO] Processing NPM proxy directory: $proxy_dir"
        find "$proxy_dir" -name "*.conf" -type f 2>/dev/null | while read -r config_file; do
            echo "[INFO] Found proxy config: $config_file"
            
            # Check if already patched with our enhanced version
            if grep -q "access_log.*minimal.*if=\$should_log" "$config_file" 2>/dev/null; then
                echo "[INFO] Already patched with enhanced logging: $(basename "$config_file")"
                continue
            fi
            
            # Remove any existing patches
            sed -i '/access_log.*minimal.*if=$loggable/d' "$config_file" 2>/dev/null
            
            # Patch the config file with enhanced logging
            if awk '/^[[:space:]]*server[[:space:]]*{/ && !added {
                print;
                print "    # Enhanced logging: first connection + periodic sampling";
                print "    access_log /var/log/nginx/access.log minimal if=$should_log;";
                print "    ";
                print "    # Set logging decision: log first connection or if API call is loggable";
                print "    set $should_log 0;";
                print "    if ($loggable = 1) {";
                print "        set $should_log 1;";
                print "    }";
                added=1; next
            } {print}' "$config_file" > "${config_file}.tmp" 2>/dev/null; then
                if mv "${config_file}.tmp" "$config_file" 2>/dev/null; then
                    echo "[INFO] Added enhanced access_log to $(basename "$config_file")"
                else
                    echo "[WARN] Failed to update $(basename "$config_file")"
                    rm -f "${config_file}.tmp" 2>/dev/null || true
                fi
            else
                echo "[WARN] Failed to process $(basename "$config_file")"
                rm -f "${config_file}.tmp" 2>/dev/null || true
            fi
        done
    fi
done

# -------------------------------------------------
# Ensure log directory exists
# -------------------------------------------------
LOG_DIR="/var/log/nginx"
if [[ ! -d "$LOG_DIR" ]]; then
    echo "[INFO] Creating log directory: $LOG_DIR"
    mkdir -p "$LOG_DIR" 2>/dev/null || echo "[WARN] Failed to create log directory"
fi

# Also create the directory that nginx expects for error logs
ERROR_LOG_DIR="/var/lib/nginx/logs"
if [[ ! -d "$ERROR_LOG_DIR" ]]; then
    echo "[INFO] Creating error log directory: $ERROR_LOG_DIR"
    mkdir -p "$ERROR_LOG_DIR" 2>/dev/null || echo "[WARN] Failed to create error log directory"
fi

# -------------------------------------------------
# Validate the final Nginx configuration
# -------------------------------------------------
echo "[INFO] Validating Nginx configuration..."
# Skip nginx test if template placeholders are present (normal for NPM)
if grep -q "%%dns_host%%" /etc/nginx/conf.d/include/resolvers.conf 2>/dev/null; then
    echo "[INFO] Skipping nginx test - template placeholders present (normal for NPM)"
else
    if nginx -t 2>/dev/null; then
        echo "[INFO] Nginx configuration syntax OK"
    else
        echo "[WARN] Nginx configuration test failed"
        nginx -t 2>&1 || true
    fi
fi

echo "[INFO] Enhanced access logging configuration complete"
echo "[INFO] You will see:"
echo "[INFO]   - First connection from each client to each proxy"
echo "[INFO]   - Regular web traffic (non-API calls)"
echo "[INFO]   - NO Home Assistant API spam"
