#!/usr/bin/with-contenv bashio
# ------------------------------------------------------------------------------
# 20-minimal-access-logs
# Configure Nginx to use concise access logs while suppressing Home Assistant noise
# ------------------------------------------------------------------------------

echo "[INFO] Enabling concise Nginx access logging with HA noise suppression..."

NGINX_CONF="/etc/nginx/nginx.conf"

# ------------------------------------------------------------------------------
# Inject minimal log format and request suppression map
# ------------------------------------------------------------------------------
if [ -f "$NGINX_CONF" ]; then
    # Define a minimal log format if not already present
    if ! grep -q "log_format minimal" "$NGINX_CONF"; then
        if sed -i '/^[[:space:]]*http[[:space:]]*{/a\    log_format minimal '\''$remote_addr $host $status "$request" $request_time s'\'';' "$NGINX_CONF"; then
            echo "[INFO] Added minimal log format to nginx.conf"
        else
            echo "[ERROR] Failed to add log format to nginx.conf" >&2
            exit 1
        fi
    fi

    # Add a map that disables logging for common HA background endpoints
    if ! grep -q 'map \$request_uri \$loggable' "$NGINX_CONF"; then
        if sed -i '/^[[:space:]]*http[[:space:]]*{/a\
    map $request_uri $loggable {\
        default 1;\
        ~^\/api\/ping 0;\
        ~^\/api\/websocket 0;\
        ~^\/api\/hassio_ingress\/ 0;\
        ~^\/api\/events 0;\
        ~^\/api\/history 0;\
        ~^\/api\/logbook 0;\
        ~^\/api\/states 0;\
        ~^\/api\/calendars\/ 0;\
        ~^\/auth\/token 0;\
        ~^\/auth\/providers 0;\
        ~^\/manifest\.json 0;\
        ~^\/service_worker\.js 0;\
        ~^\/static\/ 0;\
        ~^\/frontend_latest\/ 0;\
        ~^\/local\/ 0;\
        ~^\/media\/ 0;\
    }' "$NGINX_CONF"; then
            echo "[INFO] Added request URI suppression map to nginx.conf"
        else
            echo "[ERROR] Failed to add suppression map to nginx.conf" >&2
            exit 1
        fi
    fi
else
    echo "[WARN] nginx.conf not found at $NGINX_CONF; skipping log format injection"
fi

# ------------------------------------------------------------------------------
# Patch proxy host templates to use minimal logging with suppression
# ------------------------------------------------------------------------------
TEMPLATES_DIR="/app/templates"
if [ -d "$TEMPLATES_DIR" ]; then
    for tpl in "$TEMPLATES_DIR"/*.conf; do
        [ -f "$tpl" ] || continue
        if grep -q "access_log" "$tpl"; then
            if sed -i 's|access_log .*;|access_log /var/lib/nginx/logs/access.log minimal if=$loggable;|g' "$tpl"; then
                echo "[INFO] Patched $(basename "$tpl") to use minimal logging with suppression"
            else
                echo "[WARN] Failed to patch $(basename "$tpl")" >&2
            fi
        fi
    done
else
    echo "[WARN] Templates directory not found at $TEMPLATES_DIR; skipping template patching"
fi

echo "[INFO] Minimal access logging configuration complete"
