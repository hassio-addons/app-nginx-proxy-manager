#!/usr/bin/with-contenv bashio
# Configure Nginx to use a minimal access log format

echo "[INFO] Enabling minimal Nginx access logging..."

# Define a minimal log format if nginx.conf exists
if [ -f /etc/nginx/nginx.conf ]; then
    # Add log_format only if not already defined
    grep -q "log_format minimal" /etc/nginx/nginx.conf || \
    sed -i '/http {/a \    log_format minimal '\''$remote_addr - $status "$request"'\'';' /etc/nginx/nginx.conf
fi

# Patch all NPM template files to use minimal format
if [ -d /app/templates ]; then
    find /app/templates -type f -name "*.conf" -exec \
        sed -i 's|access_log .*;|access_log /var/lib/nginx/logs/access.log minimal;|g' {} +
    echo "[INFO] Patched access_log directives in templates."
else
    echo "[WARN] /app/templates not found — skipping template patch."
fi

