#!/usr/bin/with-contenv bashio
# Ensure correct permissions for the logrotate configuration
LOGROTATE_FILE="/etc/logrotate.d/nginx-proxy-manager"

if [ -f "$LOGROTATE_FILE" ]; then
    # Set ownership to root:root
    if ! chown root:root "$LOGROTATE_FILE"; then
        bashio::log.error "Failed to set ownership for $LOGROTATE_FILE"
        exit 1
    fi
    # Set permissions to 644
    if ! chmod 644 "$LOGROTATE_FILE"; then
        bashio::log.error "Failed to set permissions for $LOGROTATE_FILE"
        exit 1
    fi
    bashio::log.info "Set ownership to root:root and permissions to 644 for $LOGROTATE_FILE"
else
    bashio::log.warning "$LOGROTATE_FILE not found at startup"
fi
