diff --git a/backend/internal/log-viewer.js b/backend/internal/log-viewer.js
index 5e3540e..6fc0d85 100644
--- a/backend/internal/log-viewer.js
+++ b/backend/internal/log-viewer.js
@@ -5,7 +5,7 @@ import internalProxyHost from "./proxy-host.js";
 import internalRedirectionHost from "./redirection-host.js";
 import internalStream from "./stream.js";
 
-const SYSTEM_LOG_FILE = "/config/logs/backend.log";
+const SYSTEM_LOG_FILE = "/var/log/nginx-proxy-manager/backend.log";
 const LETSENCRYPT_LOG_FILE = "/config/logs/letsencrypt.log";
 
 // Matches the access_log/error_log paths written by the nginx templates
@@ -120,7 +120,7 @@ const resolveFilePath = (data) => {
 			if (!prefix || !data.host_id || !["access", "error"].includes(data.channel)) {
 				throw new errs.ValidationError("Invalid host log source");
 			}
-			return `/config/logs/${prefix}-${data.host_id}_${data.channel}.log`;
+			return `/var/log/nginx-proxy-manager/${prefix}-${data.host_id}_${data.channel}.log`;
 		}
 		default:
 			throw new errs.ItemNotFoundError(data.type);
